{
  "name": "letterbank",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.js",
  "author": {
    "name": "LetterBank"
  },
  "description": "LetterBank - clinical form letters and document generator",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_DEV=true electron .",
    "electron:build": "vite build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "app.letterbank.letters",
    "productName": "LetterBank",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    }
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
}
