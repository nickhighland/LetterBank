{
  "name": "letterbank",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron/main.js",
  "author": {
    "name": "LetterBank"
  },
  "description": "LetterBank - clinical form letters and document generator",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_DEV=true electron .",
    "electron:build": "vite build && electron-builder --mac --arm64",
    "test": "vitest run"
  },
  "build": {
    "appId": "app.letterbank.letters",
    "productName": "LetterBank",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/__tests__/**"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nickhighland",
        "repo": "LetterBank",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  }
}
